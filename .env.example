# HPS website environment variables.
# Copy this file to `.env` and adjust as needed.

# Local development: SQLite file (relative to project root for portability).
# Also used by the Prisma CLI (generate/migrate) — the CLI cannot talk to
# Turso directly, only the app's runtime client can (via the adapter below).
DATABASE_URL="file:./db/custom.db"

# Production (Vercel / any serverless host): set these two to point the app
# at your Turso database instead of local SQLite. Get them with:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
# When TURSO_DATABASE_URL is set, src/lib/db.ts automatically switches to
# the libSQL driver adapter — no code changes needed.
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token from turso db tokens create>"

# Optional: override the Smart Office early-access lead capture endpoint
# (src/app/smartoffice). Defaults to the Railway backend baked into the
# component if unset.
# NEXT_PUBLIC_SMART_OFFICE_LEADS_API="https://smart-office-production.up.railway.app/api/leads"

# Smart Office "Get started" requests are also emailed to the team through
# Brevo (the same account the Smart Office app uses). Without these two the
# request is still saved, just not emailed.
# BREVO_API_KEY="xkeysib-..."
# BREVO_FROM_EMAIL="<a sender verified in Brevo>"
# Team alerts always go to smartoffice@hiported.com and hiported@gmail.com
# (src/lib/notify.ts). Optional: more inboxes, comma-separated.
# LEADS_NOTIFY_EMAIL="someone@hiported.com"

# Password for the leads page (/smartoffice/leads). At least 12 characters.
# Without it the page stays locked for everyone.
# LEADS_ADMIN_PASSWORD="<a long password>"
